generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Keep the existing account fields. Get orgId from the signed-in user,
// not from whatever the browser sends.
model User {
  id               String    @id @default(uuid())
  name             String    @db.VarChar(20)
  email            String    @unique
  passwordHash     String
  phone            String    @unique @db.VarChar(10)
  orgId            String
  role             Role      @default(EMPLOYEE)
  active           Boolean   @default(true)
  sessionVersion   Int       @default(0)
  teamId           String?
  team             Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  photoUrl         String?
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attendance         AttendanceRecord[]
  attendanceRequests AttendanceCorrectionRequest[] @relation("AttendanceRequester")
  attendanceReviews  AttendanceCorrectionRequest[] @relation("AttendanceReviewer")

  documents Document[]
  sessions Session[]
  contacts Contact[]
  tasks    Task[]

  @@unique([orgId, id])
  @@map("users")
}

enum Role {
  ADMIN
  EMPLOYEE
  SUB_ADMIN
}

enum StageKind {
  OPEN
  WON
  LOST
}

model Team {
  id        String        @id @default(uuid())
  orgId     String
  name      String        @db.VarChar(80)
  leaderId  String?       @unique
  members   User[]
  requests  TeamRequest[]
  createdAt DateTime      @default(now())

  @@unique([orgId, name])
}

model TeamRequest {
  id          String    @id @default(uuid())
  orgId       String
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId  String
  requestedBy String
  status      String    @default("PENDING")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, status])
}

model Organisation {
  attendanceSettings AttendanceSettings?
  id                 String              @id
  createdAt          DateTime            @default(now())
}

model Contact {
  deletedAt  DateTime?
  deletedBy  String?
  id         String    @id @default(uuid())
  orgId      String
  name       String    @db.VarChar(120)
  email      String?
  phone      String?
  company    String?   @db.VarChar(120)
  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deals      Deal[]
  tasks      Task[]

  @@index([orgId, deletedAt])
  @@index([orgId, createdAt])
}

model Stage {
  id       String    @id @default(uuid())
  orgId    String
  name     String    @db.VarChar(60)
  kind     StageKind @default(OPEN)
  position Int       @default(0)
  deals    Deal[]

  @@unique([orgId, name])
  @@index([orgId, position])
}

model Deal {
  deletedAt         DateTime?
  deletedBy         String?
  id                String    @id @default(uuid())
  orgId             String
  title             String    @db.VarChar(160)
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  stageId           String
  stage             Stage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  value             Decimal   @default(0) @db.Decimal(14, 2)
  expectedCloseDate DateTime? @db.Date
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tasks             Task[]

  @@index([orgId, deletedAt])
  @@index([orgId, stageId])
  @@index([orgId, closedAt])
}

model Task {
  deletedAt  DateTime?
  deletedBy  String?
  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  id         String    @id @default(uuid())
  orgId      String
  title      String    @db.VarChar(160)
  dueDate    DateTime? @db.Date
  completed  Boolean   @default(false)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orgId, deletedAt])
  @@index([orgId, completed, dueDate])
}

model Session {
  idHash         String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int
  csrfToken      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Application history is append-only. No credential values are recorded.
model Activity {
  id          String   @id @default(uuid())
  orgId       String
  actorId     String
  actorName   String
  action      String
  entityType  String
  entityId    String?
  entityLabel String
  details     Json
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt, id])
}

// Workdays are calendar dates in the policy timezone; events are UTC instants.
model AttendanceSettings {
  orgId           String       @id
  organisation    Organisation @relation(fields: [orgId], references: [id], onDelete: Restrict)
  timeZone        String       @default("UTC")
  workingDays     Int[]        @default([1, 2, 3, 4, 5])
  startTime       String       @default("09:30")
  endTime         String       @default("18:00")
  graceMinutes    Int          @default(15)
  expectedMinutes Int          @default(480)
  updatedAt       DateTime     @updatedAt
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  orgId     String
  userId    String
  user      User              @relation(fields: [orgId, userId], references: [orgId, id], onDelete: Restrict)
  workDate  DateTime          @db.Date
  checkIn   DateTime
  checkOut  DateTime?
  policy    Json
  version   Int               @default(1)
  breaks    AttendanceBreak[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([orgId, userId, workDate])
  @@unique([orgId, id])
  @@index([orgId, workDate])
}

model AttendanceBreak {
  id       String           @id @default(uuid())
  orgId    String
  recordId String
  record   AttendanceRecord @relation(fields: [orgId, recordId], references: [orgId, id], onDelete: Restrict)
  start    DateTime
  end      DateTime?

  @@index([orgId, recordId, start])
}

enum AttendanceDecision {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceCorrectionRequest {
  id          String             @id @default(uuid())
  orgId       String
  userId      String
  user        User               @relation("AttendanceRequester", fields: [orgId, userId], references: [orgId, id], onDelete: Restrict)
  workDate    DateTime           @db.Date
  proposed    Json
  baseVersion Int?
  reason      String             @db.VarChar(1000)
  status      AttendanceDecision @default(PENDING)
  reviewedBy  String?
  reviewer    User?              @relation("AttendanceReviewer", fields: [orgId, reviewedBy], references: [orgId, id], onDelete: Restrict)
  reviewNote  String?            @db.VarChar(1000)
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())

  @@index([orgId, status, createdAt])
  @@index([orgId, userId, workDate])
}

model Document {
  id         String   @id @default(uuid())
  orgId      String
  uploaderId String
  uploader   User     @relation(fields: [orgId, uploaderId], references: [orgId, id], onDelete: Cascade)
  name       String   @db.VarChar(255)
  size       Int
  content    Bytes
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([uploaderId])
}
